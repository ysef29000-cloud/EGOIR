{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
-%}
<div class="price" data-price>
  <span data-price-now>{{ v.price | money }}</span>
  <s data-price-old{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
  <span class="tag" data-price-save{% unless v.compare_at_price > v.price %} hidden{% endunless %}>Sale</span>
</div>
