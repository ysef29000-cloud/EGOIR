{%- liquid
  assign color_index = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'color' or oname contains 'colour'
      assign color_index = forloop.index0
    endif
  endfor
-%}
<article class="card" data-card>
  <a class="card-media" href="{{ product.url }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 50vw, 25vw', widths: '400,600,900', alt: product.title, data-card-img: '' }}
      {%- if product.media[1] -%}{{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', class: 'alt', sizes: '(max-width: 760px) 50vw, 25vw', widths: '400,600,900', alt: '' }}{%- endif -%}
    {%- else -%}
      {{ 'apparel-1' | placeholder_svg_tag: 'ph' }}
    {%- endif -%}
    {%- if product.available == false -%}<span class="sticker">Sold out</span>
    {%- elsif product.compare_at_price > product.price -%}<span class="sticker">Sale</span>
    {%- elsif product.tags contains 'set' and settings.set_discount > 0 -%}<span class="sticker">−{{ settings.set_discount }}% the set</span>
    {%- elsif product.tags contains 'new' -%}<span class="sticker">New drop</span>{%- endif -%}
  </a>
  <div class="card-info">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="price">
      {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    </div>
    {%- if color_index != nil -%}
      <div class="card-dots">
        {%- for value in product.options_with_values[color_index].values -%}
          {%- liquid
            assign vimg = nil
            assign vid = nil
            for x in product.variants
              if x.options[color_index] == value
                assign vid = x.id
                if x.featured_image
                  assign vimg = x.featured_image | image_url: width: 900
                endif
                break
              endif
            endfor
          -%}
          <a href="{{ product.url }}?variant={{ vid }}" class="dot" style="background:{% render 'color-hex', name: value %}" title="{{ value | escape }}" aria-label="{{ value | escape }}"{% if vimg %} data-swap="{{ vimg }}"{% endif %}></a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
