{%- assign pv = product.selected_or_first_available_variant -%}
{%- capture code -%}{% render 'product-meta', product: product, kind: 'code' %}{%- endcapture -%}
<div class="stage-item" data-product>
  <a class="stage-img" href="{{ product.url }}">
    {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', alt: product.title, data-variant-img: '', data-w: 1000, sizes: '(max-width: 760px) 50vw, 30vw', widths: '500,800,1000' }}{%- else -%}{{ 'apparel-1' | placeholder_svg_tag: 'ph' }}{%- endif -%}
  </a>
  <div class="stage-label">
    <span class="mono">{% if code != blank %}{{ code }} — {% endif %}{{ product.title }}</span>
    <span class="mono" data-price><span data-price-now>{{ pv.price | money }}</span><s data-price-old hidden></s><span data-price-save hidden></span></span>
  </div>
  {% render 'option-picker', product: product, show_images: false %}
  <p class="soldout-note" data-soldout{% if pv.available %} hidden{% endif %}>Sold out in this option</p>
  {% render 'variant-data', product: product %}
</div>
