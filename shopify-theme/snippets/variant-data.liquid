<script type="application/json" data-variants>[
{%- for v in product.variants -%}
{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"qty":{% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %},"media":{% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]</script>
