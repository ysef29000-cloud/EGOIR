{% layout 'password' %}
<div class="pw">
  <div class="logo">{{ shop.name }}</div>
  <h1>قريب جداً.</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="coupon">
      <input type="password" name="password" placeholder="كلمة السر" autocomplete="current-password">
      <button type="submit" class="btn btn-dark">دخول</button>
    </div>
  {%- endform -%}
</div>
