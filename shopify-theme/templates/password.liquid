{% layout 'password' %}
<div class="pw">
  <div class="logo">{{ shop.name }}</div>
  <h1>Coming soon.</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="inline-form">
      <input type="password" name="password" placeholder="Password" autocomplete="current-password" aria-label="Password">
      <button type="submit" class="btn btn-dark">Enter</button>
    </div>
  {%- endform -%}
</div>
