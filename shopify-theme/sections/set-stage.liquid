{%- liquid
  assign a = section.settings.product_1 | default: settings.set_product_1
  assign b = section.settings.product_2 | default: settings.set_product_2
  if a == blank
    assign a = all_products['egoir-hoodie']
  endif
  if b == blank
    assign b = all_products['egoir-pants']
  endif
  assign pct = settings.set_discount
-%}
<section class="stage" id="set" data-set>
  <div class="stage-word" aria-hidden="true"><div class="stage-track">{%- for i in (1..4) -%}<span>{{ section.settings.word | default: shop.name }}</span>{%- endfor -%}</div></div>
  <div class="stage-meta mono">
    <span>{{ section.settings.left_note }}</span>
    <span>{{ section.settings.right_note }}{% if pct > 0 %} — save {{ pct }}%{% endif %}</span>
  </div>
  {%- if a != blank and b != blank and a.id and b.id -%}
    <div class="stage-duo">
      {% render 'stage-item', product: a %}
      {% render 'stage-item', product: b %}
    </div>
    <div class="stage-bar">
      <div class="stage-total mono"><span>Set</span> <s data-set-old></s> <b data-set-price></b></div>
      <a class="btn btn-light" data-set-buy href="{{ routes.cart_url }}">Buy the set</a>
      <button type="button" class="btn btn-ghost" data-set-add>Add to bag</button>
    </div>
  {%- else -%}
    <p class="stage-empty mono">Choose the hoodie and pants in Theme settings → The set.</p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Set stage (first screen)",
  "settings": [
    { "type": "text", "id": "word", "label": "Big moving word", "default": "EGOIR" },
    { "type": "text", "id": "left_note", "label": "Small text (left)", "default": "Drop 01 / 2026" },
    { "type": "text", "id": "right_note", "label": "Small text (right)", "default": "Hoodie + pants" },
    { "type": "product", "id": "product_1", "label": "Item 1 (default: theme setting)" },
    { "type": "product", "id": "product_2", "label": "Item 2 (default: theme setting)" }
  ],
  "presets": [ { "name": "Set stage (first screen)" } ]
}
{% endschema %}
