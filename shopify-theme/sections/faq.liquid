<section class="faq">
  <h2 class="section-title"><span class="mono sec-n" data-sec-n></span>{{ section.settings.title }}</h2>
  {%- for block in section.blocks -%}
    <details class="acc" {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="rte">{{ block.settings.a }}</div></details>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [ { "type": "text", "id": "title", "label": "Heading", "default": "FAQ" } ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}
