{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="shop" id="shop">
  {%- if section.settings.title != blank -%}<h2 class="section-title"><span class="mono sec-n" data-sec-n></span>{{ section.settings.title }}</h2>{%- endif -%}
  <div class="grid cols-{{ section.settings.columns }}">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="card"><div class="card-media">{{ 'apparel-1' | placeholder_svg_tag: 'ph' }}</div><div class="card-info"><h3>Product name</h3><div class="price">{{ 120000 | money }}</div></div></article>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.show_all -%}<div class="center"><a class="btn btn-outline" href="{{ col.url }}">View all</a></div>{%- endif -%}
</section>
{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop all" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = all products" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "checkbox", "id": "show_all", "label": "Show \"View all\" button", "default": false }
  ],
  "presets": [ { "name": "Product grid" } ]
}
{% endschema %}
