<section class="shop">
  <h1 class="section-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" class="inline-form search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="btn btn-dark">Search</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
    <div class="grid cols-4">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
      {%- else -%}<p class="empty">No results for "{{ search.terms }}".</p>{%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center pager">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}{ "name": "Search" }{% endschema %}
