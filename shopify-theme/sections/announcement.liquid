{%- if section.settings.text != blank -%}
<div class="marquee" aria-label="{{ section.settings.text | escape }}">
  <div class="marquee-track" aria-hidden="true">
    {%- for i in (1..8) -%}<span>{{ section.settings.text }}</span>{%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Cash on delivery all over Egypt" }
  ]
}
{% endschema %}
