<section class="page-wrap">
  <h1>السلة</h1>
  {%- if cart.item_count > 0 -%}
  <form action="{{ routes.cart_url }}" method="post" class="cart-page">
    {%- for item in cart.items -%}
      <div class="ci">
        <div class="ci-img">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.product.title }}{% endif %}</div>
        <div><h4><a href="{{ item.url }}">{{ item.product.title }}</a></h4>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title }}</small>{% endunless %}
          <div class="qty"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="الكمية"></div></div>
        <div class="end"><b>{{ item.final_line_price | money }}</b><br><a class="rm" href="{{ item.url_to_remove }}">حذف</a></div>
      </div>
    {%- endfor -%}
    <div class="row total"><span>الإجمالي</span><b>{{ cart.total_price | money }}</b></div>
    <div class="cart-actions">
      <button type="submit" name="update" class="btn btn-outline">تحديث</button>
      <button type="submit" name="checkout" class="btn btn-dark btn-big">إتمام الطلب</button>
    </div>
  </form>
  {%- else -%}
    <p class="empty">السلة فاضية</p>
    <div class="center"><a class="btn btn-dark" href="{{ routes.all_products_collection_url }}">ابدأ التسوق</a></div>
  {%- endif -%}
</section>
{% schema %}{ "name": "السلة" }{% endschema %}
