<section class="page-wrap">
  <h1 class="section-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    {%- for article in blog.articles -%}
      <article class="post"><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><small class="muted">{{ article.published_at | date: '%b %d, %Y' }}</small><div class="rte">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</div></article>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}<div class="center pager">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
