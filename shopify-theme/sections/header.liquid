<header class="header" data-header>
  <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-label="Menu" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
  </button>
  <a href="{{ routes.root_url }}" class="logo">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, height: section.settings.logo_height, style: 'width:auto' }}
    {%- else -%}{{ shop.name }}{%- endif -%}
  </a>
  <nav class="nav" data-nav>
    {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
  </nav>
  <div class="header-icons">
    <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></a>
    <a href="{{ routes.cart_url }}" class="icon-btn cart-btn" data-open-cart aria-label="Bag">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 70, "step": 2, "unit": "px", "default": 28 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
