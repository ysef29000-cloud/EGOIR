{%- assign has = section.blocks.size -%}
{%- if has > 0 or request.design_mode -%}
<section class="insta">
  <h2 class="section-title">{{ section.settings.title }}</h2>
  <div class="insta-grid">
    {%- for block in section.blocks -%}
      <a href="{{ section.settings.link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 50vw, 16vw', widths: '300,450,600', alt: '' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ph' }}{%- endif -%}
      </a>
    {%- else -%}
      {%- for i in (1..6) -%}<span>{{ 'lifestyle-2' | placeholder_svg_tag: 'ph' }}</span>{%- endfor -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.link != blank -%}
  <div class="center">
    <a class="btn btn-dark btn-icon" href="{{ section.settings.link }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
      {{ section.settings.button }}
    </a>
  </div>
  {%- endif -%}
</section>
{%- endif -%}
{% schema %}
{
  "name": "Instagram gallery",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Follow us" },
    { "type": "url", "id": "link", "label": "Instagram link" },
    { "type": "text", "id": "button", "label": "Button", "default": "Follow us" }
  ],
  "max_blocks": 6,
  "blocks": [ { "type": "image", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Photo" } ] } ],
  "presets": [ { "name": "Instagram gallery" } ]
}
{% endschema %}
