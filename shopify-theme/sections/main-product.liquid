{%- liquid
  assign v = product.selected_or_first_available_variant
  assign set_a = settings.set_product_1
  if set_a == blank
    assign set_a = all_products['egoir-hoodie']
  endif
  assign set_b = settings.set_product_2
  if set_b == blank
    assign set_b = all_products['egoir-pants']
  endif
  assign partner = nil
  if set_a.id == product.id and set_b.id
    assign partner = set_b
  elsif set_b.id == product.id and set_a.id
    assign partner = set_a
  endif
-%}
<section class="pdp" data-product data-pdp>
  <div class="gallery" data-gallery>
    {%- for media in product.media -%}
      <div class="gallery-item" data-media-id="{{ media.id }}">
        {%- if media.media_type == 'image' -%}
          {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
          {{ media | image_url: width: 1600 | image_tag: loading: ld, sizes: '(max-width: 760px) 100vw, 60vw', widths: '600,900,1200,1600', alt: media.alt | default: product.title }}
        {%- else -%}
          {{ media | media_tag }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="gallery-item">{{ 'apparel-1' | placeholder_svg_tag: 'ph' }}</div>
    {%- endfor -%}
  </div>
  {%- if product.media.size > 1 -%}<div class="gallery-dots" data-gallery-dots aria-hidden="true">{%- for m in product.media -%}<i></i>{%- endfor -%}</div>{%- endif -%}

  <div class="pdp-body">
    {%- capture code -%}{% render 'product-meta', product: product, kind: 'code' %}{%- endcapture -%}
    <p class="mono pdp-code">{% if code != blank %}{{ code }}{% else %}{{ product.type }}{% endif %}</p>
    <h1>{{ product.title }}</h1>
    {% render 'price', product: product, variant: v %}

    {%- form 'product', product, class: 'pdp-form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
      {% render 'option-picker', product: product, show_images: true %}
      {% render 'stock-note', product: product %}
      <a class="btn btn-dark btn-block btn-big{% unless v.available %} is-off{% endunless %}" data-buy href="{{ routes.cart_url }}/{{ v.id }}:1">Buy it now</a>
      <button type="submit" class="btn btn-outline btn-block" data-add {% unless v.available %}disabled{% endunless %}>Add to bag</button>
      <p class="soldout-note" data-soldout{% if v.available %} hidden{% endif %}>Gone in this option. Pick another size or colour.</p>
      <ul class="checks">
        {%- for block in section.blocks -%}{%- if block.type == 'point' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}
      </ul>
    {%- endform -%}

    {%- capture specs -%}{% render 'product-meta', product: product, kind: 'specs' %}{%- endcapture -%}
    {%- if specs != blank -%}<ul class="specs mono">{{ specs }}</ul>{%- endif -%}

    {%- if partner -%}{% render 'set-offer', partner: partner %}{%- endif -%}

    <div class="accs">
      {%- if product.description != blank -%}
        <details class="acc" open><summary>Product details</summary><div class="rte">{{ product.description }}</div></details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <details class="acc" {{ block.shopify_attributes }}><summary>{{ block.settings.title }}</summary><div class="rte">{{ block.settings.text }}</div></details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {% render 'variant-data', product: product %}

  <div class="sticky-buy" data-sticky>
    <div><b>{{ product.title }}</b><span data-sticky-variant>{{ v.title }}</span></div>
    <a class="btn btn-dark{% unless v.available %} is-off{% endunless %}" data-buy href="{{ routes.cart_url }}/{{ v.id }}:1">Buy it now</a>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "Product",
  "name": {{ product.title | json }},
  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}null{% endif %},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": { "@type": "Offer", "priceCurrency": {{ cart.currency.iso_code | json }}, "price": {{ v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}", "url": "{{ request.origin }}{{ product.url }}" }
}
</script>
{% schema %}
{
  "name": "Product page",
  "blocks": [
    { "type": "point", "name": "Check line", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Cash on delivery available" } ] },
    { "type": "tab", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Shipping" },
      { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Text</p>" }
    ] }
  ]
}
{% endschema %}
