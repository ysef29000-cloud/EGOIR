{%- assign v = product.selected_or_first_available_variant -%}
<section class="pdp" data-product data-pdp>
  <div class="gallery">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
        {{ media | image_url: width: 1400 | image_tag: loading: ld, sizes: '(max-width: 760px) 100vw, 50vw', widths: '600,900,1400', alt: media.alt | default: product.title }}
      {%- else -%}
        {{ media | media_tag }}
      {%- endif -%}
    {%- else -%}
      {{ 'apparel-1' | placeholder_svg_tag: 'ph' }}
    {%- endfor -%}
  </div>

  <div class="pdp-body">
    <h1>{{ product.title }}</h1>
    {% render 'price', product: product, variant: v %}
    {% render 'stock-note', product: product %}

    {%- form 'product', product, class: 'pdp-form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign oi = forloop.index0 -%}
          <fieldset class="opt">
            <legend>{{ option.name }}: <b data-opt-label="{{ oi }}">{{ option.selected_value }}</b></legend>
            <div class="sizes">
              {%- for value in option.values -%}
                <button type="button" class="size{% if value == option.selected_value %} on{% endif %}" data-opt="{{ oi }}" data-value="{{ value | escape }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if section.settings.size_guide != blank -%}
        <details class="size-guide"><summary>📏 دليل المقاسات</summary>
          <ul>{%- assign lines = section.settings.size_guide | newline_to_br | split: '<br />' -%}{%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
        </details>
      {%- endif -%}

      <a class="btn btn-dark btn-big btn-block{% unless v.available %} is-off{% endunless %}" data-buy href="{{ routes.cart_url }}/{{ v.id }}:1">{{ section.settings.buy_label }}</a>
      <button type="submit" class="btn btn-outline btn-block" data-add {% unless v.available %}disabled{% endunless %}>أضف للسلة</button>
      <p class="sold-out" data-soldout {% if v.available %}hidden{% endif %}>المقاس ده خلص — جرّب مقاس تاني</p>
    {%- endform -%}

    <ul class="pdp-meta">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>

    {%- if product.description != blank -%}<div class="rte">{{ product.description }}</div>{%- endif -%}
  </div>
  {% render 'variant-data', product: product %}

  <div class="sticky-buy">
    <div><b>{{ product.title }}</b>{% render 'price', product: product, variant: v %}</div>
    <a class="btn btn-dark{% unless v.available %} is-off{% endunless %}" data-buy href="{{ routes.cart_url }}/{{ v.id }}:1">اطلب الآن</a>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "Product",
  "name": {{ product.title | json }},
  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}null{% endif %},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": { "@type": "Offer", "priceCurrency": {{ cart.currency.iso_code | json }}, "price": {{ v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}", "url": "{{ request.origin }}{{ product.url }}" }
}
</script>
{% schema %}
{
  "name": "صفحة المنتج",
  "settings": [
    { "type": "text", "id": "buy_label", "label": "نص زرار الشراء", "default": "اطلب الآن — ادفع عند الاستلام" },
    { "type": "textarea", "id": "size_guide", "label": "دليل المقاسات (سطر لكل مقاس)", "default": "S: وزن 55-65 كجم، طول 160-170\nM: وزن 65-75 كجم، طول 170-178\nL: وزن 75-85 كجم، طول 175-185\nXL: وزن 85-95 كجم، طول 180-190" }
  ],
  "blocks": [
    { "type": "point", "name": "ميزة", "settings": [ { "type": "text", "id": "text", "label": "النص", "default": "🚚 يوصلك خلال 2-4 أيام" } ] }
  ]
}
{% endschema %}
