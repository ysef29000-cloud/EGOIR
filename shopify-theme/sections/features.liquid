<section class="features">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Features row",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "Feature", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Cash on delivery" },
      { "type": "text", "id": "text", "label": "Text", "default": "All over Egypt" }
    ] }
  ],
  "presets": [ { "name": "Features row", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
