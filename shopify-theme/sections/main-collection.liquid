<section class="shop">
  <h1 class="section-title">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}<div class="rte muted center-text">{{ collection.description }}</div>{%- endif -%}
  {%- paginate collection.products by 24 -%}
    <div class="grid cols-4">
      {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- else -%}<p class="empty">No products yet.</p>{%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center pager">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Collection" }{% endschema %}
