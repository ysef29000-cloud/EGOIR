{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="reviews">
  <h2>{{ section.settings.title }}</h2>
  {%- if section.blocks.size == 0 -%}<p class="muted">ضيف آراء عملاء حقيقية من "إضافة block".</p>{%- endif -%}
  <div class="reviews-grid">
    {%- for block in section.blocks -%}
      <div class="review" {{ block.shopify_attributes }}>
        <div class="stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
        <p>"{{ block.settings.text }}"</p>
        <small>{{ block.settings.name }}{% if block.settings.city != blank %} — {{ block.settings.city }}{% endif %}</small>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "آراء العملاء",
  "settings": [ { "type": "text", "id": "title", "label": "العنوان", "default": "عملاءنا بيقولوا إيه" } ],
  "blocks": [
    { "type": "review", "name": "رأي عميل", "settings": [
      { "type": "text", "id": "name", "label": "الاسم" },
      { "type": "text", "id": "city", "label": "المدينة" },
      { "type": "textarea", "id": "text", "label": "الرأي" },
      { "type": "range", "id": "stars", "label": "النجوم", "min": 1, "max": 5, "step": 1, "default": 5 }
    ] }
  ],
  "presets": [ { "name": "آراء العملاء" } ]
}
{% endschema %}
