<section class="trust">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "نقاط الثقة",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "نقطة", "settings": [
      { "type": "text", "id": "title", "label": "العنوان", "default": "💵 الدفع عند الاستلام" },
      { "type": "text", "id": "text", "label": "التفاصيل", "default": "كل محافظات مصر" }
    ] }
  ],
  "presets": [ { "name": "نقاط الثقة", "blocks": [ { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
