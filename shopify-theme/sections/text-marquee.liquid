<section class="tmq" aria-label="{{ section.settings.text | escape }}">
  <div class="tmq-track" aria-hidden="true">{%- for i in (1..6) -%}<span>{{ section.settings.text }}</span>{%- endfor -%}</div>
</section>
{% schema %}
{ "name": "Scrolling text", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Worn with intent" } ], "presets": [ { "name": "Scrolling text" } ] }
{% endschema %}
