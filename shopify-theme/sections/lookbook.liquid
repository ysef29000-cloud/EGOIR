<section class="lookbook">
  <span class="lb-vert mono">{{ section.settings.side }}</span>
  {%- for block in section.blocks limit: 3 -%}
    <figure class="lb-img lb-{{ forloop.index }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '600,1000,1400', alt: block.settings.caption }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ph' }}{%- endif -%}
      <figcaption class="mono"><span>{{ forloop.index | prepend: '0' }}</span><span>{{ block.settings.caption }}</span></figcaption>
    </figure>
  {%- endfor -%}
  <div class="lb-text">
    <p class="lb-quote">{{ section.settings.quote }}</p>
    {%- if section.settings.sub != blank -%}<p class="lb-sub">{{ section.settings.sub }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="link-arrow mono" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label }} →</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "side", "label": "Side text", "default": "Lookbook / 2026" },
    { "type": "textarea", "id": "quote", "label": "Big line", "default": "Worn with intent." },
    { "type": "text", "id": "sub", "label": "Small line", "default": "Heavy fabric. Clean lines. Nothing extra." },
    { "type": "text", "id": "button_label", "label": "Link", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Link URL" }
  ],
  "max_blocks": 3,
  "blocks": [ { "type": "image", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Photo" }, { "type": "text", "id": "caption", "label": "Caption", "default": "Hoodie — Iron" } ] } ],
  "presets": [ { "name": "Lookbook", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" } ] } ]
}
{% endschema %}
