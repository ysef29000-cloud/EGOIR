<section class="ugc">
  <h2 class="section-title">{{ section.settings.title }}</h2>
  <div class="ugc-row">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div class="ugc-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 70vw, 22vw', widths: '400,700', alt: '' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'ph' }}{%- endif -%}
        {%- if p != blank -%}
          <a class="ugc-chip" href="{{ p.url }}">
            <span class="ugc-thumb">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
            <span><span class="ugc-name">{{ p.title }}</span><span class="ugc-price">{{ p.price | money }}</span></span>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Photo cards (swipe)",
  "settings": [ { "type": "text", "id": "title", "label": "Heading", "default": "Real people. Real fits." } ],
  "max_blocks": 10,
  "blocks": [ { "type": "card", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo (portrait)" },
    { "type": "product", "id": "product", "label": "Product shown" } ] } ],
  "presets": [ { "name": "Photo cards (swipe)", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
