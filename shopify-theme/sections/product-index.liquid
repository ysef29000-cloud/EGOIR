{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="index" id="shop">
  <div class="index-head mono"><span>{{ section.settings.title }}</span><span>{{ col.products_count }} pieces</span></div>
  {%- for product in col.products limit: 20 -%}
    {%- capture code -%}{% render 'product-meta', product: product, kind: 'code' %}{%- endcapture -%}
    {%- liquid
      assign n_colors = 0
      for option in product.options_with_values
        assign oname = option.name | downcase
        if oname contains 'color' or oname contains 'colour'
          assign n_colors = option.values.size
        endif
      endfor
    -%}
    <a class="ix" href="{{ product.url }}"{% if product.featured_image %} data-ix-img="{{ product.featured_image | image_url: width: 700 }}"{% endif %}>
      <span class="mono ix-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
      <span class="ix-thumb">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
      <span class="ix-title">{{ product.title }}</span>
      <span class="mono ix-meta">{% if code != blank %}{{ code }}{% endif %}{% if n_colors > 1 %}{% if code != blank %} · {% endif %}{{ n_colors }} colours{% endif %}{% unless product.available %} · sold out{% endunless %}</span>
      <span class="ix-price">{%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}</span>
    </a>
  {%- endfor -%}
  {%- if section.settings.show_set and settings.set_discount > 0 -%}
    <a class="ix ix-set" href="#set">
      <span class="mono ix-n">→</span><span class="ix-thumb"></span>
      <span class="ix-title">The set</span>
      <span class="mono ix-meta">Hoodie + pants · any colours</span>
      <span class="ix-price">−{{ settings.set_discount }}%</span>
    </a>
  {%- endif -%}
  <div class="ix-float" data-ix-float aria-hidden="true"><img alt="" width="460" height="613"></div>
</section>
{% schema %}
{
  "name": "Product index (list)",
  "settings": [
    { "type": "text", "id": "title", "label": "Label", "default": "Index" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = all products" },
    { "type": "checkbox", "id": "show_set", "label": "Show \"The set\" row", "default": true }
  ],
  "presets": [ { "name": "Product index (list)" } ]
}
{% endschema %}
