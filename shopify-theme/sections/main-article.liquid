<section class="page-wrap">
  <h1 class="section-title">{{ article.title }}</h1>
  <p class="muted center-text">{{ article.published_at | date: '%b %d, %Y' }}</p>
  {%- if article.image -%}{{ article.image | image_url: width: 1600 | image_tag: class: 'article-img', alt: article.title }}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</section>
{% schema %}{ "name": "Article" }{% endschema %}
