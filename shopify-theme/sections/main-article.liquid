<section class="page-wrap">
  <h1>{{ article.title }}</h1>
  <small class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</small>
  {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: class: 'article-img', alt: article.title }}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</section>
{% schema %}{ "name": "مقال" }{% endschema %}
