<section class="shop">
  <div class="section-head"><h1>الكولكشنز</h1></div>
  <div class="grid">
    {%- for c in collections -%}
      <a class="card" href="{{ c.url }}"><div class="media">{% if c.featured_image %}{{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'ph' }}{% endif %}</div><div class="info"><h3>{{ c.title }}</h3></div></a>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "كل الكولكشنز" }{% endschema %}
