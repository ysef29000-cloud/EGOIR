<section class="shop">
  <h1 class="section-title">Collections</h1>
  <div class="grid cols-3">
    {%- for c in collections -%}
      <a class="card" href="{{ c.url }}"><div class="card-media">{% if c.featured_image %}{{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'ph' }}{% endif %}</div><div class="card-info"><h3>{{ c.title }}</h3></div></a>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Collections list" }{% endschema %}
